<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower.
   The Room database is never backed up, so a stale schema from an older build
   cannot be restored over a newer one. DataStore prefs (domain "file") stay backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="nya.db" />
    <exclude domain="database" path="nya.db-shm" />
    <exclude domain="database" path="nya.db-wal" />
</full-backup-content>
